# Copy to server/.env and adjust. Never commit server/.env (it holds database credentials).

# MongoDB connection (required). Atlas SRV form; the database name is the URI path (/ai_quest):
#   MONGO_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/ai_quest?retryWrites=true&w=majority
# Special characters in the password must be URL-encoded (@ → %40, # → %23, / → %2F …).
# On Atlas also add this machine's public IP under Network Access.
# Use MONGO_URI=memory for a throw-away in-memory database (development / rehearsal only; data is lost on
# exit; refused when NODE_ENV=production). `npm run dev:memory` does this for you.
MONGO_URI=

# Optional: database name override. Precedence: MONGO_DB → the URI path → "ai_quest".
MONGO_DB=

# Secret for signing admin JWTs (HS256, 12 h). REQUIRED when NODE_ENV=production (the server refuses to start
# without it). In development, if empty, a random secret is generated once and stored in the app_meta collection.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin account created on FIRST boot only (when the admins collection is empty).
# Afterwards change the password in Admin -> Settings -> Account.
ADMIN_EMAIL=a@gmail.com
ADMIN_PASSWORD=123456

# HTTP port of the API + Socket.IO (+ built client in production).
PORT=4000

# Only needed when the client is served from a different origin than this server
# (comma-separated list, e.g. https://results.example.edu). Empty = same-origin only.
CORS_ORIGIN=

# Set when running behind a reverse proxy so rate limiting sees real client IPs:
# "1" (one proxy hop), "loopback", a CIDR list, or "true" (trust everything — avoid).
TRUST_PROXY=

# Several server processes behind a load balancer: "mongo" shares Socket.IO broadcasts and viewer counts
# through the capped collection socket_io_events (needs a replica set — every Atlas cluster is one).
# Empty = single instance.
SOCKET_ADAPTER=

# "production" for the live event: requires JWT_SECRET, refuses MONGO_URI=memory.
NODE_ENV=

# Optional HTTP timeouts (ms). REQUEST_TIMEOUT_MS bounds a whole request including a bulk photo upload.
# HEADERS_TIMEOUT_MS=30000
# REQUEST_TIMEOUT_MS=120000
